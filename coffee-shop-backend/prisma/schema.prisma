generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model category {
  id      Int       @id @default(autoincrement())
  name    String
  product product[]
}

model order {
  id            Int          @id @default(autoincrement())
  createdAt     DateTime     @default(now())
  totalAmount   Decimal      @db.Decimal(10, 2)
  status        order_status @default(PENDING)
  paymentStatus String       @default("UNPAID")
  paymentMethod String       @default("QR")
  userId        Int
  voucherId     Int?
  discount      Decimal      @default(0.00) @db.Decimal(10, 2)
  user          user         @relation(fields: [userId], references: [id], map: "Order_userId_fkey")
  voucher       voucher?     @relation(fields: [voucherId], references: [id])
  orderitem     orderitem[]

  @@index([userId], map: "Order_userId_fkey")
}

model orderitem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  orderId   Int
  productId Int
  order     order   @relation(fields: [orderId], references: [id], map: "OrderItem_orderId_fkey")
  product   product @relation(fields: [productId], references: [id], map: "OrderItem_productId_fkey")

  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@index([productId], map: "OrderItem_productId_fkey")
}

model product {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean     @default(true)
  categoryId  Int
  orderitem   orderitem[]
  category    category    @relation(fields: [categoryId], references: [id], map: "Product_categoryId_fkey")

  @@index([categoryId], map: "Product_categoryId_fkey")
}

model user {
  id        Int       @id @default(autoincrement())
  email     String    @unique(map: "User_email_key")
  password  String
  name      String?
  role      user_role @default(STAFF)
  createdAt DateTime  @default(now())
  order     order[]
}

enum order_status {
  PENDING
  COMPLETED
  CANCELLED
}

enum user_role {
  ADMIN
  STAFF
}

model voucher {
  id            Int            @id @default(autoincrement())
  code          String         @unique
  discountType  discount_type  @default(PERCENTAGE)
  discountValue Decimal        @db.Decimal(10, 2)
  minOrderValue Decimal        @default(0.00) @db.Decimal(10, 2)
  maxDiscount   Decimal?       @db.Decimal(10, 2)
  startDate     DateTime
  endDate       DateTime
  usageLimit    Int            @default(100)
  usedCount     Int            @default(0)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  order         order[]
}

enum discount_type {
  PERCENTAGE
  FIXED
}
